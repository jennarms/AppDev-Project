@page
@model MetroLayag.Pages.PassengerReportModel
@{
    ViewData["Title"] = "Passenger Reports";
    Layout = "_Layout";
}

<div class="container mt-4">
    <h1 class="mt-4 p-3 text-white" style="background-color: #4e048d; border-radius: 10px;">
        <img src="~/appdevAssets/Passengers_Icon.png" alt="Logo" width="50" height="50" class="me-2" />
        Passenger Reports
    </h1>

    <!-- Toggle Buttons -->
    <div class="btn-group my-4" role="group" aria-label="Toggle Report Views">
        <button type="button" class="btn btn-outline-success" onclick="showSection('successful')">View Successful Trips</button>
        <button type="button" class="btn btn-outline-danger" onclick="showSection('canceled')">View Canceled Passengers</button>
    </div>

    <form method="get" class="mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <label for="filterDate" class="col-form-label">Filter by Date:</label>
        </div>
        <div class="col-auto">
            <input type="date" name="FilterDate" id="filterDate" class="form-control" value="@Model.FilterDate?.ToString("yyyy-MM-dd")" />
        </div>

        <div class="col-auto">
            <label for="station" class="col-form-label">Filter by Station:</label>
        </div>
        <div class="col-auto">
            <select name="SelectedStation" id="station" class="form-select">
                <option value="">-- All Stations --</option>
                @foreach (var station in Model.Stations)
                {
                    <option value="@station" selected="@(Model.SelectedStation == station ? "selected" : null)">@station</option>
                }
            </select>
        </div>

        <div class="col-auto">
            <button type="submit" class="btn" style="background-color: #4e048d; color: white;">Apply</button>
        </div>

        <div class="col-auto">
            <a asp-page="/PassengerReport" class="btn btn-secondary">Revert</a>
        </div>
    </div>
        <div class="col-12 mt-3 text-end">
            <a class="btn btn-success me-2"
               asp-controller="Export"
               asp-action="SuccessfulPdf"
               asp-route-filterDate="@Model.FilterDate?.ToString("yyyy-MM-dd")"
               asp-route-selectedStation="@Model.SelectedStation"
               target="_blank">
                Export PDF (Successful)
            </a>

            <a class="btn btn-danger"
               asp-controller="Export"
               asp-action="CanceledPdf"
               asp-route-filterDate="@Model.FilterDate?.ToString("yyyy-MM-dd")"
               asp-route-selectedStation="@Model.SelectedStation"
               target="_blank">
                Export PDF (Canceled)
            </a>
        </div>
</form>


    <!-- Successful Trips Section -->
    <div id="successful-section">
        <h4 class="text-success">Successful Trips</h4>
        @if (Model.PagedSuccessfulPassengers.Any())
        {
            <table class="table table-bordered table-striped mt-3">
                <thead class="table-success">
                    <tr>
                        <th>Name</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Starting Station</th>
                        <th>Destination</th>
                        <th>Booking Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.PagedSuccessfulPassengers)
                    {
                        <tr>
                            <td>@p.FullName</td>
                            <td>@p.Gender</td>
                            <td>@p.Age</td>
                            <td>@p.StartingStation</td>
                            <td>@p.Destination</td>
                            <td>@p.BookingDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div>
                @Html.PagedListPager(Model.PagedSuccessfulPassengers, page => Url.Page("PassengerReport", null, new
                    {
                        PageSuccessful = page,
                        PageCanceled = Model.PageCanceled,
                        FilterDate = Model.FilterDate?.ToString("yyyy-MM-dd"),
                        SelectedStation = Model.SelectedStation
                    }, null), new PagedListRenderOptions
       {
           UlElementClasses = new[] { "pagination" },
           LiElementClasses = new[] { "page-item" },
           PageClasses = new[] { "page-link" }
       })

            </div>
        }
        else
        {
            <p>No passengers have completed their trip yet.</p>
        }
    </div>

    <!-- Canceled Passengers Section -->
    <div id="canceled-section" style="display: none;">
        <h4 class="text-danger">Canceled Passengers</h4>
        @if (Model.PagedCanceledPassengers.Any())
        {
            <table class="table table-bordered table-striped mt-3">
                <thead class="table-danger">
                    <tr>
                        <th>Name</th>
                        <th>Gender</th>
                        <th>Age</th>
                        <th>Starting Station</th>
                        <th>Destination</th>
                        <th>Booking Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.PagedCanceledPassengers)
                    {
                        <tr>
                            <td>@p.FullName</td>
                            <td>@p.Gender</td>
                            <td>@p.Age</td>
                            <td>@p.StartingStation</td>
                            <td>@p.Destination</td>
                            <td>@p.BookingDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div>
                @Html.PagedListPager(Model.PagedCanceledPassengers, page => Url.Page("PassengerReport", null, new
                    {
                        PageCanceled = page,
                        PageSuccessful = Model.PageSuccessful,
                        FilterDate = Model.FilterDate?.ToString("yyyy-MM-dd"),
                        SelectedStation = Model.SelectedStation
                    }, null), new PagedListRenderOptions
       {
           UlElementClasses = new[] { "pagination" },
           LiElementClasses = new[] { "page-item" },
           PageClasses = new[] { "page-link" }
       })

            </div>
        }

        else
        {
            <p>No canceled passengers.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        function showSection(section) {
            document.getElementById('successful-section').style.display = section === 'successful' ? 'block' : 'none';
            document.getElementById('canceled-section').style.display = section === 'canceled' ? 'block' : 'none';
        }
    </script>
}