@page
@model MetroLayag.Pages.EditAccountModel
@{
    ViewData["Title"] = "Edit Account";
}
<h1 class="mt-5 mb-4 px-4 py-3 text-white flex items-center gap-3" style="background-color: #4e048d; border-radius: 10px;">
    <img src="~/appdevAssets/Passengers_Icon.png" alt="Logo" width="50" height="50" />
    Edit My Account
</h1>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form method="post">
    <div class="mb-3">
        <label asp-for="Username" class="form-label">New Username</label>
        <input asp-for="Username" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label">New Password</label>
        <input asp-for="Password" type="password" class="form-control" />
    </div>
    <button type="submit" class="btn" style="background-color: #4e048d; color: white;" onclick="return confirm('Are you sure you want to save the changes?')">Save Changes</button>
</form>
