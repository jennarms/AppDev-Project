<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MetroLayag</title>
    <link rel="icon" type="image/png" href="appdevAssets/Logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MetroLayag.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-purple">
            <div class="container">
                <!-- Logo with icon -->
                <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                    <img src="~/appdevAssets/Logo.png" alt="Logo" width="50" height="50" class="me-2" />
                    MetroLayag
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Booking"><img src="~/appdevAssets/Booking_Icon.png" alt="Logo" width="35" height="35" class="me-2" />Booking</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Disembarking"><img src="~/appdevAssets/Disembark_Icon.png" alt="Logo" width="35" height="35" class="me-2" />Disembarking</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/PassengerReport"><img src="~/appdevAssets/Passengers_Icon.png" alt="Logo" width="35" height="35" class="me-2" />Passenger Report</a>
                        </li>

                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Logout" onclick="return confirm('Are you sure you want to log out?')">
                                <img src="~/appdevAssets/Logout_Icon.png" alt="Logout" width="24" height="24" />
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MetroLayag
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
